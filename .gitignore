# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build output
dist/
build/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# React / Vite cache
.cache/
.parcel-cache/
.eslintcache

# Uploaded runtime files - do not push live uploaded images
public/uploads/panos/*
public/uploads/maps/*

# Keep upload folders in Git
!public/uploads/panos/.gitkeep
!public/uploads/maps/.gitkeep

# Optional: ignore live saved admin data
# Uncomment this if the deployed network/server should own the live config.
# public/data/streetview-data.json

# Optional backups
*.bak
*.tmp
*.old