APP_PORT=5055
TZ=Asia/Manila

POSTGRES_ENABLED=true
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=YOUR_DATABASE
POSTGRES_USER=YOUR_DEDICATED_APP_USER
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
POSTGRES_SCHEMA=map
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_SSL=false

# Uploaded images are stored inside this project by default:
#   ./public/uploads/panos
#   ./public/uploads/thumbs
#   ./public/uploads/maps
#   ./public/uploads/machines
#   ./public/uploads/safety-popups
# No machine-specific storage path is required.
# Optional override only when you deliberately want storage elsewhere:
# STREETVIEW_STORAGE_DIR=/absolute/path/to/project/public

IMPORT_JSON_ON_START=true
MAX_UPLOAD_MB=50
MAP_MAX_WIDTH=4096
MACHINE_MAX_WIDTH=1800

# Automatic Pannellum multi-resolution generation for 360 panoramas.
# Docker includes the required Python + Hugin/nona tools automatically.
MULTIRES_ENABLED=true
MULTIRES_TILE_SIZE=512
MULTIRES_FALLBACK_SIZE=1024
MULTIRES_TILE_QUALITY=85
MULTIRES_TIMEOUT_MS=1200000
# For Windows `npm run dev`, these are optional overrides if Python/Hugin are
# installed locally. Docker does not need them.
# MULTIRES_PYTHON=python
# MULTIRES_NONA_PATH=C:/Program Files/Hugin/bin/nona.exe
# MULTIRES_GENERATOR_PATH=C:/path/to/pannellum/generate.py

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=CHANGE_THIS_VIEWER_PASSWORD
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
