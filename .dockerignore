# Keep uploads/data OUT of the Docker image when using volume mounts.
# They will come from the host folder instead:
#   C:\StreetViewData\uploads -> /app/public/uploads
#   C:\StreetViewData\data    -> /app/public/data
public/uploads/panos/*
public/uploads/thumbs/*
public/uploads/maps/*
!public/uploads/panos/.gitkeep
!public/uploads/thumbs/.gitkeep
!public/uploads/maps/.gitkeep
